# 設定ファイルの雛形。用途に応じてコピーして使う（詳細は 起動手順書 2章）。
#   ローカル開発 : cp .env.example .env        → DJANGO_DEBUG=1 / USE_SQLITE=1
#   Docker Compose: cp .env.example .env.docker → DJANGO_DEBUG=0 / USE_SQLITE=0
# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# PostgreSQL
POSTGRES_DB=labops
POSTGRES_USER=labops
POSTGRES_PASSWORD=labops
POSTGRES_HOST=db
POSTGRES_PORT=5432

# 1 にするとSQLiteを使う（ローカルでのテスト実行用）
USE_SQLITE=0

# 研究日記の添付ファイルを nginx の X-Accel-Redirect で配信する。
# 未指定の場合は DJANGO_DEBUG=0（本番）で自動的に有効になる。
# DJANGO_USE_X_ACCEL_REDIRECT=1

# メール送信（出張費申請の通知）
# 未設定なら DEBUG=1 でコンソール出力、DEBUG=0 で SMTP を使う
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=labops@example.ac.jp
# 出張費申請の送信先（カンマ区切り）。未設定なら教員ロールのメールアドレスへ送る
TRAVEL_EXPENSE_RECIPIENTS=
